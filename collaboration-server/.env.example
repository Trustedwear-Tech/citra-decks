# =============================================================================
# Collaboration Server — Environment Configuration
# =============================================================================

# Server
PORT=1234
PERSISTENCE_DIR=./y-leveldb-storage

# Kill switch: while false, the server answers /health but refuses every
# WebSocket upgrade. Enabled by default for citra-decks — flip to false to
# disable (the useCollaboration.js hook's own COLLABORATION_ENABLED must
# match).
COLLABORATION_ENABLED=true

# JWT Authentication — MUST be the exact same value as citra-decks' own
# JWT_SECRET (api/local_auth.py issues the tokens; this server only verifies
# them, same HS256 algorithm, same secret).
JWT_SECRET=change-me-generate-a-64-byte-hex-secret

# Required at startup (server.js exits without it) but never actually
# dereferenced over HTTP — this server verifies JWTs locally against
# JWT_SECRET, it doesn't call out to an auth service. Point it at
# citra-decks' own backend for a meaningful log line.
AUTH_SERVICE_URL=http://localhost:8085

# Environment: production | development
# production → connections without valid JWT are rejected
# development → connections allowed with warnings
NODE_ENV=development
