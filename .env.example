ENVIRONMENT=dev

# ─────────── Deployment Mode ───────────
DEPLOYMENT_MODE=onprem

# ─────────── JWT Authentication Configuration ───────────
JWT_SECRET=change-me-generate-a-64-byte-hex-secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=Citra-AI

# ─────────── Server Configuration ───────────
MAX_UPLOAD_SIZE_MB=150
MAX_REQUEST_SIZE_MB=150

# ─────────── Object Storage (S3 / MinIO) ───────────
# Uses any S3-compatible storage. Set BUCKET_ENDPOINT_URL for MinIO,
# leave empty for AWS S3.

# Bucket name (create this in MinIO Console or AWS S3 Console)
BUCKET_NAME=citra-documents
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY=minioadmin
BUCKET_SECRET_KEY=minioadmin

# MinIO endpoint (self-hosted). Leave blank for real AWS S3.
# MinIO: http://minio:9000  (Docker) or http://localhost:9000 (local dev)
# AWS S3: leave empty — boto3 auto-connects to AWS
BUCKET_ENDPOINT_URL=http://minio:9000

# ─────────── CORS Configuration ───────────
# Comma-separated list of allowed origins. Production must set this.
CORS_ALLOWED_ORIGINS=
FORCE_HTTPS=false

# ─────────── URL Configuration ───────────
# Host-facing ports (8093/8094), not the conventional 8085/8081 — see
# docker-compose.yml's port comments: this avoids colliding with another
# Citra product's stack running on the same machine.
BASE_URL=http://localhost:8093
WEBSITE_URL=http://localhost:8094
FRONTEND_URL=http://localhost:8094
APP_URL=http://localhost:8094

# ─────────── User Service URL ───────────
USER_SERVICE_URL=http://localhost:7004

# ─────────── Playwright Render Service ───────────
PLAYWRIGHT_SERVICE_URL=http://localhost:3001
PLAYWRIGHT_SERVICE_ENABLED=true

# ─────────── MongoDB ───────────
# MONGODB_USER / MONGODB_PASSWORD set the root credentials for the mongodb
# container in docker-compose.yml — MONGODB_PASSWORD has no default and
# compose refuses to start without it. docker-compose.yml builds the
# backend's MONGODB_CONN_STRING from these two automatically; the value
# below is only used if you run the backend OUTSIDE docker-compose (e.g.
# against a cloud Atlas cluster instead).
MONGODB_USER=root
MONGODB_PASSWORD=change-me-generate-a-password
# Cloud (Atlas): mongodb+srv://user:password@cluster.mongodb.net/dbname
MONGODB_CONN_STRING=mongodb://root:change-me-generate-a-password@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=citra

# MongoDB Graph
# USE_MONGODB_GRAPH removed — MongoDB is the only graph backend
MONGODB_URI=mongodb://root:password@mongodb:27017/?authSource=admin&replicaSet=rs0

# MongoDB Connection Pool Settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=600000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=60000

# ─────────── Milvus / Zilliz Vector Database ───────────
# Self-hosted: http://milvus:19530
# Cloud (Zilliz): https://your-cluster.cloud.zilliz.com
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=citra
MILVUS_FILE_SYNC_COLLECTION=file_sync

# ─────────── Redis Cache Configuration ───────────
# Self-hosted: redis (Docker service name)
# Cloud: your-redis-host.cloud.provider.com
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true

# Dedicated DURABLE job-queue Redis (citra-queue) — a SEPARATE noeviction+AOF
# instance so queued/in-flight jobs are never evicted. Unset values fall back to
# the matching REDIS_* (so the queue stays reachable; only the port differs).
#   • Prod (services + Redis on DIFFERENT boxes): queue-redis runs on the SAME
#     host as the cache Redis, published on :6380. Set ONLY the port — host and
#     password inherit from REDIS_HOST / REDIS_PASSWORD:
#         QUEUE_REDIS_PORT=6380
#   • Same docker network / single box instead: QUEUE_REDIS_HOST=queue-redis (6379).
#   • Dev (this machine): QUEUE_REDIS_HOST=localhost, QUEUE_REDIS_PORT=6380.
QUEUE_REDIS_PORT=6380
# QUEUE_REDIS_HOST=    # set to queue-redis ONLY on a shared-network deploy
# QUEUE_REDIS_PASSWORD=  # inherits REDIS_PASSWORD when blank
REDIS_SSL=false
# REDIS_URL=redis://redis:6379/0

# Performance Tuning
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECTION_POOL_MAX_CONNECTIONS=20

# ─────────── Chat Completion LLM ───────────
# Any OpenAI-compatible endpoint. Point to cloud API or self-hosted vLLM/Ollama.
# API key is optional for self-hosted/keyless endpoints.
#
# Examples:
#   Self-hosted (vLLM):        LLM_BASE_URL=http://inference:8000/v1  LLM_MODEL=your-model-name
#   DeepSeek (cloud):           LLM_BASE_URL=https://api.deepseek.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=deepseek-chat
#   Cloud API:                 LLM_BASE_URL=https://api.provider.com/v1  LLM_API_KEY=your-key  LLM_MODEL=model-name
#
# Legacy single-tier vars (used as fallback when a tier-specific var is unset):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─────────── Tiered LLM Routing (small / medium / large) ───────────
# Three tiers used strategically across the codebase:
#   - small  → whisper transcript cleanup, intent parsing, chat title generation
#   - medium → KG generation/query, RAG planner, context merger, diagrams, reader, entity extraction
#   - large  → main chat, code execution, SQL generation, workflow code-gen (default tier)
#
# Each tier may use a different provider/model. If LLM_<TIER>_* are not set, calls
# fall back to the legacy LLM_* values above.
#
# Recommended defaults via OpenRouter. Small and medium intentionally share the
# working medium config; large stays pinned to the large-tier model below.
LLM_SMALL_BASE_URL=https://openrouter.ai/api/v1
LLM_SMALL_API_KEY=
LLM_SMALL_MODEL=deepseek/deepseek-v4-flash
LLM_SMALL_EXTRA_BODY={"reasoning":{"enabled":true,"effort":"low","exclude":true}}

LLM_MEDIUM_BASE_URL=https://openrouter.ai/api/v1
LLM_MEDIUM_API_KEY=
LLM_MEDIUM_MODEL=deepseek/deepseek-v4-flash
LLM_MEDIUM_EXTRA_BODY={"reasoning":{"enabled":true,"effort":"low","exclude":true}}

LLM_LARGE_BASE_URL=https://openrouter.ai/api/v1
LLM_LARGE_API_KEY=
LLM_LARGE_MODEL=deepseek/deepseek-v4-pro
LLM_LARGE_EXTRA_BODY={"reasoning":{"enabled":true,"effort":"low","exclude":true}}

# Surface the model's reasoning/thinking tokens to chat UIs as a collapsible
# "Reasoning" card (main chat + quick chat, mirroring Action Chat). When true
# (default), the backend forces reasoning.exclude=false on the streaming call
# and emits `reasoning` SSE events as thinking arrives. Set to false for
# deployments where surfacing chain-of-thought on tool-planning rounds is a
# governance concern — reasoning then stays excluded (exclude=true) and is only
# used as an empty-content fallback.
LLM_EXPOSE_REASONING=true

# ─────────── Embedding ───────────
# Grounds every composer in your own documents. Defaults to bge-m3 (open
# weights) on the SAME OpenRouter key as the LLM above — one key, nothing
# proprietary. The client sends `dimensions` on every call, so the model
# returns 768 rather than its native 1024, matching the Milvus collection.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=768
#
# Any OpenAI-compatible endpoint works. Self-hosting the same model is a URL
# change: EMBEDDING_BASE_URL=http://inference:8000/v1 — keep 768, or set
# EMBEDDING_DIMENSION=1024 for bge-m3's native size and match the collection.
#
# CHANGING THE MODEL MEANS RE-INGESTING, even at the same dimension. Vectors
# written by one model do not share an embedding space with another model's
# queries, so old documents quietly stop matching instead of failing.

# ─────────── Vision / OCR ───────────
# Any OpenAI-compatible vision/multimodal endpoint.
#
# Examples:
#   Qwen VL (self-hosted): VISION_BASE_URL=http://vision:8000/v1  VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
#   OpenRouter (cloud):    VISION_BASE_URL=https://openrouter.ai/api/v1  VISION_API_KEY=sk-or-...  VISION_MODEL=qwen/qwen3-vl-32b-instruct
#   Cloud vision API:    VISION_BASE_URL=https://api.provider.com/v1  VISION_API_KEY=your-key  VISION_MODEL=model-name
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Critic AI vision pass kill-switch. OFF by default.
#   true  → run per-slide/page vision critique (overlap detection + layout patches)
#   false → skip it entirely; critique endpoints return elements unchanged, no vision call
#
# Off is the right default: it renders every slide and sends the image to a
# vision model, which costs time and tokens on every generation, and the
# layouts are good without it. Turn it on if you actually SEE glitches —
# overlapping elements, text running off a slide — and it will detect and
# patch them. VISION_* above only matters when this is true.
CRITIC_VISION_ENABLED=false

# ─────────── Audio-to-Text (Speech-to-Text) ───────────
# Any OpenAI-compatible Whisper endpoint, or SimpliSmart API.
#
# Examples:
#   Whisper (self-hosted): AUDIO_TO_TEXT_BASE_URL=http://whisper:8003/v1  AUDIO_TO_TEXT_MODEL=whisper-large-v3-turbo
#   SimpliSmart (cloud):   AUDIO_TO_TEXT_BASE_URL=https://api.simplismart.live/predict  AUDIO_TO_TEXT_API_KEY=...  AUDIO_TO_TEXT_PROVIDER=simplismart
#   OpenAI (cloud):        AUDIO_TO_TEXT_BASE_URL=https://api.openai.com/v1  AUDIO_TO_TEXT_API_KEY=sk-...  AUDIO_TO_TEXT_MODEL=whisper-1
AUDIO_TO_TEXT_PROVIDER=openai
AUDIO_TO_TEXT_BASE_URL=
AUDIO_TO_TEXT_API_KEY=
AUDIO_TO_TEXT_MODEL=whisper-large-v3-turbo

# ─────────── Internet Search Provider (LLM-grounded) ───────────
# Powers "search the internet" in chat — the LLM performs a live web search
# and returns sourced results (citations, real-time data).
#
#   SEARCH_PROVIDER=grok        → xAI Responses API web_search (default) — uses SEARCH_API_KEY
#   SEARCH_PROVIDER=perplexity  → Perplexity Sonar (online search built-in) — uses PERPLEXITY_API_KEY
#   SEARCH_PROVIDER=openai      → OpenAI Responses API web_search — uses OPENAI_API_KEY
#   SEARCH_PROVIDER=google      → Google Gemini with google_search grounding — uses GOOGLE_AI_API_KEY
#
# Override model: SEARCH_MODEL  (auto-selected per provider when omitted)
# Override endpoint: SEARCH_BASE_URL + SEARCH_API_KEY
SEARCH_PROVIDER=grok
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_MODEL=
SEARCH_COUNTRY=IN

# ─────────── Web Search API (Reader / RAG internet context) ───────────
# Powers the "internet search" button in the Reader and provides web results
# for RAG hybrid context. Requires a web search API key.
#
# Serper.dev (recommended) — Sign up: https://serper.dev/ (free tier: 2,500 queries)
#   SERPER_API_KEY=your-serper-api-key
#   SERPER_API_URL=https://google.serper.dev/search  (default)
#
# Fallback: DuckDuckGo Instant Answer API (free, no key, limited results)
#   DUCKDUCKGO_FALLBACK=true  (enabled by default when Serper is unavailable)
SERPER_API_KEY=
SERPER_API_URL=https://google.serper.dev/search
DUCKDUCKGO_FALLBACK=true
INTERNET_SEARCH_ENABLED=true

# ─────────── Reranker Service ───────────
RERANKER_SERVICE_URL=http://localhost:7302
ENABLE_RERANKER=true
RERANKER_TOP_K_MULTIPLIER=3
RERANKER_TIMEOUT=30

# ─────────── Workflow Engine ───────────
CONNECTION_ENCRYPTION_KEY=change-me-generate-a-32-byte-hex-key

# ─────────── Image Generation ───────────
# Provider: "runware" (cloud) or "comfyui" (self-hosted via ComfyUI HTTP API)
#
# Runware (cloud)  — required: IMAGE_GEN_API_KEY, IMAGE_GEN_MODEL
# ComfyUI (on-prem) — required: COMFYUI_SERVER_URL, IMAGE_GEN_MODEL
#                     Workflow templates live in workflows/comfyui/
#
# Examples:
#   Runware:  IMAGE_GEN_PROVIDER=runware  IMAGE_GEN_API_KEY=<key>  IMAGE_GEN_MODEL=runware:400@1
#   ComfyUI:  IMAGE_GEN_PROVIDER=comfyui  COMFYUI_SERVER_URL=http://localhost:8188  IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-schnell
# STRONGLY RECOMMENDED — set IMAGE_GEN_API_KEY.
# This is what puts real imagery on your slides and report covers. Without a
# key, generation still succeeds, but decks come out plain: no cover art, no
# section visuals, no illustrative imagery. It is the single biggest
# difference between a deck that looks designed and one that looks like a
# text outline. Runware charges a few cents per image, so a full deck costs
# very little — leaving this blank saves almost nothing and costs a lot of
# polish. Get a key at https://runware.ai
#
# Not served by OpenRouter, so it needs its own key even though everything
# else in this file runs off one.
# Three backends, chosen with IMAGE_GEN_PROVIDER:
#
#   runware  cloud, simplest — and the ONLY one that supports image EDITING
#            in the composers.
#              IMAGE_GEN_PROVIDER=runware
#              IMAGE_GEN_API_KEY=<key>
#              IMAGE_GEN_MODEL=runware:400@1
#
#   openai   any OpenAI-compatible /images/generations endpoint, which is how
#            you run FLUX without a Runware account (Together, Fal, DeepInfra,
#            Nebius, or your own server). Generation only, no editing.
#              IMAGE_GEN_PROVIDER=openai
#              IMAGE_GEN_BASE_URL=https://api.together.xyz/v1
#              IMAGE_GEN_API_KEY=<key>
#              IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-dev
#
#   comfyui  self-hosted ComfyUI server; nothing leaves your network.
#              IMAGE_GEN_PROVIDER=comfyui
#              COMFYUI_SERVER_URL=http://localhost:8188
#              IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_GEN_PROVIDER=runware
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=runware:400@1
# COMFYUI_SERVER_URL=http://localhost:8188

# ─────────── Authentication ───────────
DISABLE_AUTH=false

# ─────────── Misc ───────────
LOG_LEVEL=INFO
DEBUG=false
ENABLE_MONGODB_CHAT_HISTORY=true
MAX_CHAT_HISTORY_MESSAGES=20

# ─────────── Token Limits ───────────
MAX_INPUT_TOKENS=128000
MAX_OUTPUT_TOKENS_DEFAULT=50000
MAX_OUTPUT_TOKENS_CHAT=60000
MAX_OUTPUT_TOKENS_CEILING=120000

# ─────────── Size Limits ───────────
# File size limits (in MB)
MAX_VIDEO_SIZE_MB=2048
MAX_PDF_SIZE_MB=20
MAX_AUDIO_SIZE_MB=100
MAX_IMG_SIZE_MB=20
# Content limits
MAX_PDF_PAGES=1000
MAX_PPT_SLIDES=100
MAX_HTML_CHARS=200000
MAX_EXCEL_JSON_RECORDS=5000
MAX_AUDIO_DURATION_MINUTES=120
MAX_VIDEO_DURATION_MINUTES=180
MAX_OCR_PAGES=20
MAX_FOLDER_SYNC_FILES=10000

# ─────────── Rate Limiting ───────────
RATE_LIMIT_STANDARD=100/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_UPLOAD_VIDEO=3/minute
RATE_LIMIT_CHAT=30/minute

# ─────────── Retrieval Tuning ───────────
# Similarity threshold (fallback when adaptive is disabled)
PERSONAL_SIMILARITY_THRESHOLD=0.35

# ─────────── Dynamic Retrieval ───────────
# Smart chunk retrieval based on query complexity
ENABLE_DYNAMIC_RETRIEVAL=true

# Chunks per sub-query by complexity (before deduplication)
COMPLEX_CHUNKS_PER_SUBQUERY=10
MODERATE_CHUNKS_PER_SUBQUERY=8
SIMPLE_CHUNKS_PER_SUBQUERY=5

# ─────────── Performance Monitoring ───────────
ENABLE_QUERY_PERFORMANCE_METRICS=true
LOG_SLOW_QUERY_THRESHOLD=3.0
ALERT_VERY_SLOW_QUERY_THRESHOLD=10.0

# ─────────── Feature Flags ───────────
# LLM-based context ranking (adds ~2-3s per query)
ENABLE_CONTEXT_RANKING=false

# ─────────── Supplementary Sources ───────────
# Controls whether SaaS/SQL data is included in RAG context
INCLUDE_SUPPLEMENTARY_SOURCES=true

# ─────────── SaaS / Connection Limits ───────────
MAX_RECORDS_PER_FILE=100000

# ─────────── SaaS Embedding Tuning ───────────
SAAS_EMBEDDING_BATCH_SIZE=50
SAAS_EMBEDDING_BATCH_DELAY_SECONDS=0.5
SAAS_EMBEDDING_MAX_CONCURRENT=5
SAAS_MAX_EMBEDDING_TOKENS=2000
SAAS_USER_RATE_LIMIT_RPM=100

# ─────────── OCR / Chunking ───────────
OCR_RESOLUTION=1
DOCUMENT_CHUNK_SIZE_PAGES=1

# ─────────── Action Chat (sandboxed agent) ───────────
# These settings are read by Citra-Service AND injected as environment
# variables into every Action Chat sandbox container when it is launched
# (see services/action_sandbox_manager.py::_spawn). The sandbox image has
# NO hardcoded provider, endpoint, or model — everything below is what
# makes it work.
#
# Inside the container they appear as:
#     CITRA_ACTION_LLM_BASE_URL   ->  CITRA_LLM_BASE_URL
#     CITRA_ACTION_LLM_API_KEY    ->  CITRA_LLM_API_KEY
#     CITRA_ACTION_MODEL          ->  CITRA_ACTION_MODEL
# and are consumed by:
#   - the agent's OpenAI client (runner/agent.py) for tool-calling
#   - NeMo Guardrails (guardrails/config.yml) for input/output rails
#
# Swap these three values to move between providers (OpenRouter / any
# OpenAI-compatible endpoint). No image rebuild required; just restart
# citra-service.
CITRA_ACTION_CHAT_ENABLED=true
CITRA_ACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
CITRA_ACTION_LLM_API_KEY=
CITRA_ACTION_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------------------------------------------------------------------------
# Action Sandbox Pool (Pattern C)
# ---------------------------------------------------------------------------
# Citra-Service no longer owns Docker. It talks to a fleet of
# `action-sandbox-host` services (one per sandbox VM) over HTTP.
#
# - CITRA_ACTION_SANDBOX_HOSTS: comma-separated `host:port` list. Each
#   endpoint is an action-sandbox-host instance.
# - CITRA_ACTION_SANDBOX_HOST_SECRET: must match SANDBOX_HOST_SECRET on
#   every sandbox-host VM. This is the only thing the scheduler checks —
#   keep it long and random.
# - CITRA_ACTION_SANDBOX_SCHEDULE: "least-loaded" (default) picks the host
#   with the most remaining slots; "roundrobin" cycles through hosts.
CITRA_ACTION_SANDBOX_HOSTS=sandbox-host-1:7090
CITRA_ACTION_SANDBOX_HOST_SECRET=
CITRA_ACTION_SANDBOX_SCHEDULE=least-loaded

# ─────────── Presentation / Printable model pin ───────────
# These two surfaces (presentation_api.py / printable_api.py) stay on GLM-5.1
# even though the large tier now defaults to deepseek-v4-pro. base_url/api_key
# still come from LLM_LARGE_*; only the model is overridden.
PRESENTATION_LLM_MODEL=z-ai/glm-5.1
PRINTABLE_LLM_MODEL=z-ai/glm-5.1
