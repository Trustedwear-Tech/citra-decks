# Dockerfile for Citra AI Service
# Multi-stage build: compile Python → .so with Cython, then ship only compiled files

# ─── Stage 1: Build & Compile ────────────────────────────────────
FROM python:3.11-slim AS builder

ARG APP_ENV=prod

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install build deps (gcc for Cython, ffmpeg stays in final image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
  && rm -rf /var/lib/apt/lists/*

# Install Python deps + Cython
COPY requirements.txt /app/
RUN pip install -r /app/requirements.txt && \
    pip install cython setuptools

# Copy source code
COPY . /app

# Compile .py → .so and remove originals
RUN python cython_build.py

# ─── Stage 2: Production Image ───────────────────────────────────
FROM python:3.11-slim

ARG APP_ENV=prod

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=America/New_York \
    DEBIAN_FRONTEND=noninteractive \
    APP_ENV=${APP_ENV}

WORKDIR /app

# Install runtime-only system deps (no gcc)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    tzdata \
  && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy compiled app (only .so + main.py + __init__.py + assets)
COPY --from=builder /app /app

EXPOSE 7001

# Healthcheck (switch to /health if you have one)
HEALTHCHECK --interval=1m --timeout=5s --start-period=20s --retries=5 CMD curl -fsS http://127.0.0.1:7001/health >/dev/null || exit 1

# Gunicorn + Uvicorn workers
CMD ["gunicorn", "main:app", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-w", "1", "-b", "0.0.0.0:7001", \
     "--timeout", "1200", "--graceful-timeout", "30", \
     "--max-requests", "2000", "--max-requests-jitter", "200", \
     "--access-logfile", "-", "--error-logfile", "-", \
     "--capture-output", "--log-level", "info"]
