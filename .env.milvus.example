# ===========================================
# Milvus / Zilliz Cloud Configuration
# ===========================================
# Migration from Pinecone to Milvus on Zilliz Cloud

# Environment: dev, test, or prod
# This determines which collection to use:
# - dev -> dev
# - test -> test  
# - prod -> prod
ENVIRONMENT=dev

# Zilliz Cloud Connection
# Format: https://in03-<your-cluster-id>.api.gcp-us-west1.zillizcloud.com
ZILLIZ_CLOUD_URI=https://in03-823285122a3d96a.api.gcp-us-west1.zillizcloud.com

# Zilliz Cloud API Key
ZILLIZ_CLOUD_API_KEY=4f2f01f6a30ac396506225ce8e9e7b2b7284e137243656913d91949da7248b57ab6df90f8fba4c93108dfbb47b89d793b536b318

# Optional: Zilliz Cloud User/Password (if using user-based auth instead of API key)
ZILLIZ_CLOUD_USER=db_823285122a3d96a
ZILLIZ_CLOUD_PASSWORD=Lu7)TW[k.ml2l6tn

# ===========================================
# Collection Information
# ===========================================
# Collections are already created with dimension 768:
# - dev (for development)
# - test (for testing)
# - prod (for production)
# 
# The service will automatically use the correct collection
# based on the ENVIRONMENT variable above.

# ===========================================
# Embedding Configuration
# ===========================================
# See main .env for EMBEDDING_BASE_URL, EMBEDDING_API_KEY, EMBEDDING_MODEL
EMBEDDING_MODEL=text-embedding-3-small
EMBED_DIM=768
EMBEDDING_TASK_TYPE=RETRIEVAL_QUERY
# EMBEDDING_DOCUMENT_TASK=RETRIEVAL_DOCUMENT

