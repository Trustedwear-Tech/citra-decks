"""
SSE Credit Alerts — Real-time push notifications when a user's credit balance goes negative.

Flow:
1. Client opens EventSource to GET /sse/credit-alerts?token=<jwt>
2. Server subscribes to Redis pub/sub channel  credit_alert:{user_id}
3. When CreditBufferService or UsageTrackingService detects balance < 0 after a
   deduction, it publishes a JSON payload to that channel.
4. This endpoint forwards the payload as an SSE event to the connected client.
5. Client receives  event: credit_alert  and triggers the buy-credits popup.

ALB compatibility:
- Sends heartbeats every 15s to stay within ALB idle timeout (default 60s)
- Retries Redis connection with backoff if pub/sub fails
- Never closes the SSE stream due to transient Redis errors

Depends on:
- redis.asyncio  (bundled with redis>=4.5.0)
- auth_middleware  (JWT already validated by middleware; user_id in request.state)
"""

import os
import json
import asyncio
import logging
from fastapi import APIRouter, Request
from fastapi.responses import StreamingResponse
from auth_middleware import get_secure_user_id

logger = logging.getLogger(__name__)

router = APIRouter(tags=["SSE Credit Alerts"])

# Redis connection params (same env vars as CacheManager)
_REDIS_HOST = os.getenv("REDIS_HOST", "localhost")
_REDIS_PORT = int(os.getenv("REDIS_PORT", "6379"))
_REDIS_DB = int(os.getenv("REDIS_DB", "0"))
_REDIS_PASSWORD = os.getenv("REDIS_PASSWORD", None)
_REDIS_SSL = os.getenv("REDIS_SSL", "").lower() in ("1", "true", "yes")

# Channel prefix — must match what credit_buffer_service / usage_tracking_service publish to
CHANNEL_PREFIX = "credit_alert"

# Heartbeat interval — must be well under ALB idle timeout (default 60s).
# 15s keeps the connection alive through ALB, NLB, and browser timeouts.
HEARTBEAT_INTERVAL = 15

# Redis retry config — retries inside the SSE stream instead of killing it
_REDIS_MAX_RETRIES = 5
_REDIS_RETRY_BASE_DELAY = 2  # seconds, doubles each retry (2, 4, 8, 16, 32)


async def _create_async_redis():
    """Create a NEW async Redis client (not pooled — pub/sub needs dedicated connections)."""
    try:
        import redis.asyncio as aioredis
        conn_kwargs = {
            "host": _REDIS_HOST,
            "port": _REDIS_PORT,
            "db": _REDIS_DB,
            "decode_responses": True,
            "socket_connect_timeout": 10,
            "socket_timeout": 30,
            "retry_on_timeout": True,
        }
        _redis_username = os.getenv("REDIS_USERNAME")
        if _redis_username:
            conn_kwargs["username"] = _redis_username
        if _REDIS_PASSWORD:
            conn_kwargs["password"] = _REDIS_PASSWORD
        if _REDIS_SSL:
            conn_kwargs["ssl"] = True
            conn_kwargs["ssl_cert_reqs"] = None
        client = aioredis.Redis(**conn_kwargs)
        await client.ping()
        return client
    except Exception as e:
        logger.error(f"❌ [SSE-CREDIT] Failed to create async Redis connection: {e}")
        return None


@router.get("/sse/credit-alerts")
async def credit_alerts_sse(request: Request):
    """
    Long-lived SSE stream that pushes credit_alert events when balance goes negative.
    Auth: JWT token via query param (?token=...) — EventSource can't set headers.

    ALB-safe: sends heartbeats every 15s and retries Redis on failure.
    """
    user_id = get_secure_user_id(request)

    async def event_stream():
        channel = f"{CHANNEL_PREFIX}:{user_id}"
        redis_conn = None
        pubsub = None
        retry_count = 0

        async def _cleanup_redis():
            nonlocal redis_conn, pubsub
            try:
                if pubsub:
                    await pubsub.unsubscribe(channel)
                    await pubsub.close()
            except Exception:
                pass
            try:
                if redis_conn:
                    await redis_conn.aclose()
            except Exception:
                pass
            pubsub = None
            redis_conn = None

        async def _connect_redis():
            """Attempt to connect to Redis and subscribe. Returns True on success."""
            nonlocal redis_conn, pubsub, retry_count
            await _cleanup_redis()
            redis_conn = await _create_async_redis()
            if redis_conn is None:
                return False
            try:
                pubsub = redis_conn.pubsub()
                await pubsub.subscribe(channel)
                retry_count = 0  # Reset on success
                logger.info(f"📡 [SSE-CREDIT] User {user_id} subscribed to {channel}")
                return True
            except Exception as e:
                logger.error(f"❌ [SSE-CREDIT] Redis subscribe failed for {user_id}: {e}")
                await _cleanup_redis()
                return False

        try:
            # Initial connection attempt
            connected = await _connect_redis()
            if not connected:
                logger.warning(f"⚠️ [SSE-CREDIT] Initial Redis connect failed for {user_id}, will retry in stream")

            while True:
                # Check if client disconnected
                if await request.is_disconnected():
                    logger.info(f"📡 [SSE-CREDIT] Client disconnected: {user_id}")
                    break

                # If not connected to Redis, retry with backoff
                if pubsub is None:
                    retry_count += 1
                    if retry_count > _REDIS_MAX_RETRIES:
                        logger.warning(f"⚠️ [SSE-CREDIT] Max Redis retries reached for {user_id}, resetting counter")
                        retry_count = 1  # Reset and keep trying (don't kill SSE)

                    delay = min(_REDIS_RETRY_BASE_DELAY * (2 ** (retry_count - 1)), 32)
                    logger.info(f"🔄 [SSE-CREDIT] Redis retry {retry_count} for {user_id} in {delay}s")

                    # Send heartbeats while waiting for retry delay
                    elapsed = 0
                    while elapsed < delay:
                        if await request.is_disconnected():
                            return
                        yield ": heartbeat\n\n"
                        await asyncio.sleep(min(HEARTBEAT_INTERVAL, delay - elapsed))
                        elapsed += HEARTBEAT_INTERVAL

                    connected = await _connect_redis()
                    if not connected:
                        continue  # Will retry again on next iteration
                    # Fall through to message loop below

                # Listen for messages with heartbeats
                try:
                    message = await asyncio.wait_for(
                        pubsub.get_message(ignore_subscribe_messages=True, timeout=1.0),
                        timeout=HEARTBEAT_INTERVAL,
                    )
                except asyncio.TimeoutError:
                    message = None
                except Exception as e:
                    logger.warning(f"⚠️ [SSE-CREDIT] Redis read error for {user_id}: {e}")
                    await _cleanup_redis()
                    yield ": heartbeat\n\n"
                    continue  # Will reconnect on next iteration

                if message and message["type"] == "message":
                    data = message["data"]
                    logger.info(f"💰 [SSE-CREDIT] Pushing credit_alert to {user_id}: {data}")
                    yield f"event: credit_alert\ndata: {data}\n\n"
                else:
                    # Heartbeat — keeps ALB / browser from closing the idle connection
                    yield ": heartbeat\n\n"

        except asyncio.CancelledError:
            logger.info(f"📡 [SSE-CREDIT] Stream cancelled for {user_id}")
        except Exception as e:
            logger.error(f"❌ [SSE-CREDIT] Error in event stream for {user_id}: {e}")
            yield f"event: error\ndata: {{\"message\": \"Stream error\"}}\n\n"
        finally:
            await _cleanup_redis()
            logger.info(f"📡 [SSE-CREDIT] Cleaned up subscription for {user_id}")

    return StreamingResponse(
        event_stream(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "X-Accel-Buffering": "no",       # Disable nginx buffering
            "Transfer-Encoding": "chunked",   # Ensure ALB streams chunks immediately
        },
    )
